# Kopiere diese Datei nach .env und trage deinen Google-Gemini-API-Key ein.
# Key holen: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Modell: gemini-3.5-flash
#   guenstiger/schneller: gemini-3.1-flash-lite  |  Auto-Alias (immer neueste): gemini-flash-latest
MODEL=gemini-3.5-flash

# Port des Mini-Backends (Standard: 8787)
# PORT=8787

# Name des Bewerbers - wird fuer die Anzeigenamen der hochgeladenen Dateien benutzt
# (z.B. "Lebenslauf_Max_Mustermann.pdf").
# APPLICANT_NAME=Max Mustermann

# Pfad zum career-ops-Ordner (fuer den Ref/PDF-Finder). Standard: ../../career-ops
# CAREER_OPS_DIR=/pfad/zu/career-ops
