    {
      "term": "Software Engineer",
      "location": "Berlin, Germany"
    },
    {
      "term": "Backend Developer",
      "location": "Munich, Germany"
    },
    {
      "term": "Software Engineer",
      "location": "Germany",
      "is_remote": true
    }
  ],
  "exclude_title_keywords": [
    "Praktikum",
    "Werkstudent",
    "Ausbildung",
    "Intern",
    "Thesis",
    "Abschlussarbeit",
    "Vertrieb",
    "Sales",
    "Recruiter"
  ]
}
